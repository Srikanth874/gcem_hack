# ============================================================
#  GCEM_HACK — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit your real .env to version control.
# ============================================================

# ── Roboflow ────────────────────────────────────────────────
# Get a free API key at: https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=your_api_key_here

# ── Dataset settings (defaults match the download script) ───
ROBOFLOW_WORKSPACE=solar-panel-defect-detection
ROBOFLOW_PROJECT=yolov8-4qenz
ROBOFLOW_VERSION=1
ROBOFLOW_FORMAT=yolov8

# ── Sensor simulator settings ────────────────────────────────
# Interval in seconds between sensor readings
SENSOR_INTERVAL_SECONDS=5
